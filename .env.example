# PORT: Port HTTP server (default: 3000).
PORT="3000"

# HOST: Alamat bind HTTP server (default: 127.0.0.1 untuk lokal; gunakan 0.0.0.0 di Docker/Cloud Run hanya di balik gateway akses/VPN).
HOST="127.0.0.1"

# TRUST_PROXY: Kepercayaan header X-Forwarded-For Express (default: false; gunakan jumlah hop spesifik seperti "1" di Cloud Run, hindari "true").
TRUST_PROXY="false"

# GEMINI_API_KEY: Kunci API Gemini untuk adapter server-side (diisi melalui panel Secrets AI Studio / env server).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL_ALLOWLIST: Daftar ID model Gemini yang diizinkan (dipisah koma). Jika kosong pada HOST non-loopback otomatis dibatasi ke model default (gemini-4-hydrogen); nilai eksplisit menggantikan bawaan dan disinkronkan ke UI via /api/providers/status.
GEMINI_MODEL_ALLOWLIST=""

# OPENROUTER_API_KEY: Kunci API opsional untuk adapter OpenRouter (biarkan kosong jika tidak dipakai).
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL_ALLOWLIST: Daftar ID model OpenRouter yang diizinkan (dipisah koma). Jika kosong pada HOST non-loopback otomatis mengizinkan model default, fallback gratis, model *:free, & model gratis dari katalog live; nilai eksplisit menimpa aturan bawaan dan menandai model berbayar di UI.
OPENROUTER_MODEL_ALLOWLIST=""

# NOUS_API_KEY: Kunci API opsional untuk Nous Portal (opsional; bisa juga login langsung via OAuth di UI).
NOUS_API_KEY=""

# NOUS_MODEL_ALLOWLIST: Daftar ID model Nous Portal yang diizinkan (dipisah koma). Jika kosong pada HOST non-loopback otomatis mengizinkan model default, fallback gratis, model *:free, & model gratis dari katalog live; nilai eksplisit menimpa aturan bawaan.
NOUS_MODEL_ALLOWLIST=""

# NOUS_OAUTH_CLIENT_ID: Client ID OAuth Device Flow untuk Nous Portal (default: hermes-cli).
NOUS_OAUTH_CLIENT_ID="hermes-cli"

# ENABLE_NOUS_OAUTH: Izinkan endpoint /api/oauth/nous/* dan katalog model Nous saat HOST non-loopback (default: false; selalu aktif di loopback).
ENABLE_NOUS_OAUTH="false"

# APINEX_API_KEY: Kunci API opsional untuk APInex (https://apinex.bond, awalan sk-apx...).
APINEX_API_KEY=""

# APINEX_MODEL_ALLOWLIST: Daftar ID model APInex yang diizinkan (dipisah koma). Jika kosong pada HOST non-loopback otomatis mengizinkan model default, fallback gratis, model free/*, & model gratis dari katalog live; nilai eksplisit menimpa aturan bawaan.
APINEX_MODEL_ALLOWLIST=""

# CUSTOM_API_KEY: Kunci API opsional untuk provider OpenAI-compatible pada allowlist server.
CUSTOM_API_KEY=""

# RATE_LIMIT_PER_MIN: Batas maksimum request API per menit per IP (default: 20).
RATE_LIMIT_PER_MIN="20"

# STRICT_RATE_LIMIT_PER_MIN: Batas ketat per menit per IP untuk rute tes provider/agent, katalog model, dan OAuth Nous (default: 6).
STRICT_RATE_LIMIT_PER_MIN="6"

# DAILY_CALL_CAP: Batas maksimum panggilan model harian di memori server (default: 300).
DAILY_CALL_CAP="300"

# DAILY_TOKEN_CAP: Batas maksimum estimasi akumulasi token harian di memori server (default: 2000000).
DAILY_TOKEN_CAP="2000000"

# SERVER_MAX_TOKENS_CAP: Plafon keras server untuk maxTokens per permintaan agent (default: 16384).
SERVER_MAX_TOKENS_CAP="16384"

# BODY_LIMIT_MB: Batas maksimum ukuran body request dalam megabyte (default: 10).
BODY_LIMIT_MB="10"

# AUTO_FREE_FALLBACK: Beralih otomatis sekali ke model gratis bawaan provider saat APInex, OpenRouter, atau Nous Portal mengembalikan HTTP 402 (default: true).
# Catatan: pemilihan model gratis internal saat 402 tidak divalidasi ulang terhadap allowlist eksplisit provider.
AUTO_FREE_FALLBACK="true"
