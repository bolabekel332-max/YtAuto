# PORT: Port HTTP server (default: 3000).
PORT="3000"

# TRUST_PROXY: Kepercayaan header X-Forwarded-For Express (default: false; isi angka hop seperti "1" di Cloud Run/reverse proxy).
TRUST_PROXY="false"

# GEMINI_API_KEY: Kunci API Gemini untuk adapter server-side (diisi melalui panel Secrets AI Studio / env server).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL_ALLOWLIST: Opsional, daftar ID model Gemini yang diizinkan dipisah koma (kosongkan untuk perilaku default).
GEMINI_MODEL_ALLOWLIST=""

# OPENROUTER_API_KEY: Kunci API opsional untuk adapter OpenRouter (biarkan kosong jika tidak dipakai).
OPENROUTER_API_KEY=""

# NOUS_API_KEY: Kunci API opsional untuk Nous Portal (opsional; bisa juga login langsung via OAuth di UI).
NOUS_API_KEY=""

# NOUS_OAUTH_CLIENT_ID: Client ID OAuth Device Flow untuk Nous Portal (default: hermes-cli).
NOUS_OAUTH_CLIENT_ID="hermes-cli"

# CUSTOM_API_KEY: Kunci API opsional untuk provider OpenAI-compatible pada allowlist server.
CUSTOM_API_KEY=""

# RATE_LIMIT_PER_MIN: Batas maksimum request API per menit per IP (default: 20).
RATE_LIMIT_PER_MIN="20"

# DAILY_CALL_CAP: Batas maksimum panggilan model harian di memori server (default: 300).
DAILY_CALL_CAP="300"

# BODY_LIMIT_MB: Batas maksimum ukuran body request dalam megabyte (default: 10).
BODY_LIMIT_MB="10"
